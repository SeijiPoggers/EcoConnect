// ═══════════════════════════════════════════════════════
//  EcoConnect — Schema v3 (Produção)
//  Banco: PostgreSQL
//  Alterações v3:
//    - Adicionado institutionMode em ProfessionalProfile
//    - Adicionado institutionCount em ProfessionalProfile
//    - Adicionado modelo Institution (substitui Organization para criações)
//    - Adicionado InstitutionMember (M:N profissional <-> instituição)
//    - Organization mantida apenas para compatibilidade de agendamentos
//    - Seed de demonstração removido
// ═══════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────

enum UserRole {
  PATIENT
  PROFESSIONAL
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LogType {
  OBSERVATION
  SESSION
  PROGRESS
  NOTE
}

enum ConditionType {
  TEA
  ADHD
  DYSLEXIA
  DYSPRAXIA
  OTHER
  UNSPECIFIED
}

enum ObjectiveCategory {
  SLEEP
  EMOTIONAL
  SOCIAL
  MOTOR
  COGNITIVE
  ROUTINE
  COMMUNICATION
  OTHER
}

// Papel do profissional dentro de uma instituição
enum InstitutionRole {
  ADMIN   // Criador / administrador da instituição
  MEMBER  // Profissional vinculado
}

// ─── Modelos ──────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  role      UserRole @default(PATIENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile      PatientProfile?
  professionalProfile ProfessionalProfile?
  logsCreated         Log[]               @relation("LogAuthor")
  objectivesCreated   Objective[]         @relation("ObjectiveAuthor")

  @@map("users")
  @@index([email])
}

model PatientProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  condition      ConditionType @default(UNSPECIFIED)
  conditionNotes String?
  xp             Int           @default(0)
  level          Int           @default(1)
  professionalId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile? @relation(fields: [professionalId], references: [id])
  objectives   Objective[]
  logs         Log[]
  appointments Appointment[]

  @@map("patient_profiles")
}

model ProfessionalProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  crp              String?
  specialty        String?
  bio              String?
  experience       String?
  photoUrl         String?
  education        String?
  approaches       String[]
  languages        String[]
  isVerified       Boolean  @default(false)

  // Modo Instituição
  institutionMode  Boolean  @default(false)  // Ativado pelo profissional
  institutionCount Int      @default(0)       // Contador (máx 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients     PatientProfile[]
  appointments Appointment[]
  memberships  InstitutionMember[]  // Vínculos com instituições

  @@map("professional_profiles")
}

// Instituição criada por profissional com Modo Instituição ativo
model Institution {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String?
  city        String
  state       String   @default("SP")
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  emoji       String   @default("🏥")
  slotsTotal  Int      @default(10)
  slotsUsed   Int      @default(0)
  rating      Float    @default(5.0)
  isActive    Boolean  @default(true)
  createdById String   // ProfessionalProfile.id do criador

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags         InstitutionTag[]
  members      InstitutionMember[]
  appointments Appointment[]      @relation("InstitutionAppointments")

  @@map("institutions")
}

model InstitutionTag {
  id            String      @id @default(uuid())
  institutionId String
  tag           String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, tag])
  @@map("institution_tags")
}

// Relacionamento M:N — ProfessionalProfile <-> Institution
model InstitutionMember {
  id              String          @id @default(uuid())
  institutionId   String
  professionalId  String
  role            InstitutionRole @default(MEMBER)
  joinedAt        DateTime        @default(now())

  institution  Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([institutionId, professionalId])
  @@map("institution_members")
}

// Organização (mantida para compatibilidade — não recebe novos dados via UI)
model Organization {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String?
  city        String
  state       String   @default("SP")
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  rating      Float    @default(5.0)
  slotsTotal  Int      @default(10)
  slotsUsed   Int      @default(0)
  emoji       String   @default("🏥")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags         OrganizationTag[]
  appointments Appointment[]

  @@map("organizations")
}

model OrganizationTag {
  id             String       @id @default(uuid())
  organizationId String
  tag            String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tag])
  @@map("organization_tags")
}

model Objective {
  id          String            @id @default(uuid())
  patientId   String
  createdById String
  text        String
  category    ObjectiveCategory @default(OTHER)
  done        Boolean           @default(false)
  xpReward    Int               @default(15)
  deadline    DateTime?
  doneAt      DateTime?
  isVisible   Boolean           @default(true)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User           @relation("ObjectiveAuthor", fields: [createdById], references: [id])

  @@map("objectives")
  @@index([patientId])
}

model Log {
  id          String   @id @default(uuid())
  patientId   String
  createdById String
  type        LogType  @default(OBSERVATION)
  title       String
  content     String
  isVisible   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User           @relation("LogAuthor", fields: [createdById], references: [id])

  @@map("logs")
  @@index([patientId, createdAt])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  organizationId  String?           // Legacy
  institutionId   String?           // Novo
  professionalId  String
  date            DateTime
  time            String
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  cancelReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient      PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id])
  institution  Institution?    @relation("InstitutionAppointments", fields: [institutionId], references: [id])

  @@map("appointments")
  @@index([patientId, date])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
